{
  "manifest_version": 3,
  "name": "DualLens 双语对照翻译",
  "short_name": "DualLens",
  "version": "0.6.0",
  "description": "段落级双语网页翻译。支持自选OpenAI兼容接口、本地模型及自定义服务。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus",
    "scripting",
    "offscreen",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/subtitles/observer.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/loader.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "content/comics/*.js",
        "content/subtitles/*.js",
        "platform/*.js",
        "shared/*.js",
        "styles/content.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "DualLens",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "ui/options.html",
  "side_panel": { "default_path": "sidepanel/index.html" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": { "default": "Alt+S" },
      "description": "打开 DualLens 文本翻译侧栏"
    },
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "翻译 / 恢复当前页面"
    },
    "toggle-translation-only": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "切换双语对照 / 仅显示译文"
    },
    "translate-input": {
      "suggested_key": {
        "default": "Alt+I"
      },
      "description": "翻译当前输入框的内容"
    },
    "toggle-hover": {
      "description": "开关悬停翻译"
    }
  },
  "key": ""
}
