{
  "manifest_version": 3,
  "name": "DualLens 双语对照翻译",
  "short_name": "DualLens",
  "version": "0.6.0",
  "description": "段落级双语网页翻译。支持自选OpenAI兼容接口、本地模型及自定义服务。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus",
    "scripting",
    "offscreen",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://clients5.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/adaptive-layout.js",
        "content/client.js",
        "content/comics/controller.js",
        "content/comics/discovery.js",
        "content/comics/order.js",
        "content/comics/panel.js",
        "content/comics/sites.js",
        "content/confirmation.js",
        "content/controller.js",
        "content/floatball.js",
        "content/frame-agent.js",
        "content/frames.js",
        "content/hover.js",
        "content/idle.js",
        "content/injector.js",
        "content/inputbox.js",
        "content/main.js",
        "content/observer.js",
        "content/overlay.js",
        "content/presentation.js",
        "content/selection.js",
        "content/serialize.js",
        "content/subtitles/controller.js",
        "content/subtitles/files.js",
        "content/subtitles/html5.js",
        "content/subtitles/json3.js",
        "content/subtitles/observe.js",
        "content/subtitles/overlay.js",
        "content/subtitles/scheduler.js",
        "content/subtitles/track.js",
        "content/subtitles/youtube.js",
        "content/util.js",
        "content/visual.js",
        "content/walker.js",
        "platform/extension.js",
        "platform/http.js",
        "platform/port-client.js",
        "platform/settings-store.js",
        "shared/device-state.js",
        "shared/hash.js",
        "shared/identifiers.js",
        "shared/lang.js",
        "shared/markup.js",
        "shared/metadata.js",
        "shared/protocol.js",
        "shared/settings.js",
        "shared/site-adapters.js",
        "shared/site-pattern.js",
        "shared/storage-areas.js",
        "shared/ui-glossary.js",
        "styles/content.css",
        "shared/destinations.js",
        "shared/errors.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "DualLens",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "ui/options.html",
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "打开 DualLens 文本翻译侧栏"
    },
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "翻译 / 恢复当前页面"
    },
    "toggle-translation-only": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "切换双语对照 / 仅显示译文"
    },
    "translate-input": {
      "suggested_key": {
        "default": "Alt+I"
      },
      "description": "翻译当前输入框的内容"
    },
    "toggle-hover": {
      "description": "开关悬停翻译"
    }
  },
  "key": "",
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
